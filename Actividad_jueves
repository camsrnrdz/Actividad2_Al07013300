print("\n=========================================================")
print("Ejercicio 6: Vidas y daño")
print("======================== BATALLA ========================")

# 1. Inicio del personaje
personaje = "Lisa"
vida = 100
print(f"\nMi personaje se llama {personaje} y empieza con {vida} de vida")

# 2. Primer golpe (Goblin - 25 de daño)
# Actualizamos la variable: 100 - 25 = 75
vida = vida - 25
print(f"Me dio un golpe de un goblin, ahora tengo vida: {vida}")

# 3. Segundo golpe (Ogro - 40 de daño)
# Actualizamos la variable: 75 - 40 = 35
vida = vida - 40
print(f"Ah, ahora me tocó el golpe de un ogro, tengo de vida: {vida}")

# 4. Tercer golpe (Flecha - 15 de daño)
# Actualizamos la variable: 35 - 15 = 20
vida = vida - 15
print(f"Me tocó una flecha enemiga!, tengo de vida: {vida}")

# 5. Curación (Poción - +30 de vida)
# Actualizamos la variable: 20 + 30 = 50
vida = vida + 30
print(f"Tomó una poción... mi vida: {vida}")

# 6. Estado final
print(f"\n{personaje} terminó la batalla con {vida} HP\n")
print("=========================================================")